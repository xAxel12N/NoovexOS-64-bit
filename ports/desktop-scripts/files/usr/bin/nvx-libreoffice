#!/bin/sh
P=/opt/libreoffice/program
[ -x $P/soffice.bin ] || { echo "LibreOffice: /opt/libreoffice is missing - the Linux files were not loaded by the boot loader (needs about 1 GB of RAM)" >&2; exit 1; }
export LD_LIBRARY_PATH=/opt/libreoffice/nvxlib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export SAL_USE_VCLPLUGIN=gen
exec $P/soffice --norestore --nologo "$@"
