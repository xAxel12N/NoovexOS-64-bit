#!/bin/bash
B=/tmp/.nvx-session-bus; P=$B.pid
if [ -f "$P" ] && kill -0 "$(cat "$P" 2>/dev/null)" 2>/dev/null && [ -e "$B" ]; then echo "unix:path=$B"; exit 0; fi
rm -f "$B" "$P"
if command -v dbus-daemon >/dev/null 2>&1; then dbus-daemon --session --address="unix:path=$B" --fork --print-pid > "$P" 2>>/tmp/dbus-session.log; fi
for i in $(seq 50); do [ -e "$B" ] && break; sleep 0.1; done
if [ -e "$B" ]; then echo "unix:path=$B"; else echo "unix:path=/tmp/.nvx-no-session-bus"; fi
