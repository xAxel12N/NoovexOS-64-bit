PREFIX=/usr
MANDIR=/usr/share/man
SBINDIR=/usr/bin
BINM_PAGER=less
MANPATH_DEFAULT=/usr/share/man:/usr/local/share/man
MANPATH_BASE=/usr/share/man
OSNAME="NoovexOS"
UTF8_LOCALE=C.UTF-8
LN="ln -sf"
INSTALL_LIBMANDOC=0
LD_OHASH=
LD_NANOSLEEP=
LD_RECVMSG=
